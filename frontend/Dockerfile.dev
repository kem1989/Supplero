FROM node:18-alpine

# Set working directory
WORKDIR /app

# Copy package files first for better caching
COPY package*.json ./

# Install all dependencies
RUN npm install && npm cache clean --force

# Copy source code
COPY . .

# Create .next directory
RUN mkdir -p .next

# Expose port
EXPOSE 3000

# Start development server
CMD ["npm", "run", "dev"] 