# Supplero Testing Environment Configuration
# Copy this file to .env.testing and update with your actual values

# Database Configuration
POSTGRES_DB=supplero
POSTGRES_USER=supplero
POSTGRES_PASSWORD=supplero_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379

# OpenAI Configuration
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4
OPENAI_VISION_MODEL=gpt-4-vision-preview

# Security Configuration
SECRET_KEY=your_very_secure_secret_key_for_testing_change_this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Configuration
ENVIRONMENT=testing
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://YOUR_EC2_PUBLIC_IP:8000
NEXT_PUBLIC_APP_NAME=Supplero
NEXT_PUBLIC_APP_VERSION=1.0.0

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# File Storage Configuration
STORAGE_TYPE=local
STORAGE_PATH=./uploads
MAX_FILE_SIZE=10485760  # 10MB

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@supplero.com

# Monitoring and Analytics
SENTRY_DSN=
DATADOG_API_KEY=
PROMETHEUS_ENABLED=false

# External API Keys (for supplier data)
DUN_BRADSTREET_API_KEY=
REFINITIV_API_KEY=
NEWS_API_KEY=73b1570193ea4621911c859decfda84b

