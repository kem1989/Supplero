# Supplero Testing Environment Configuration
# Copy this file to .env.testing and update with your actual values

# Environment
ENVIRONMENT=testing
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
POSTGRES_DB=supplero
POSTGRES_USER=supplero
POSTGRES_PASSWORD=secure_testing_password_2024_change_this
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379

# OpenAI Configuration (REQUIRED)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_VISION_MODEL=gpt-4-vision-preview

# Security Configuration (CHANGE THESE!)
SECRET_KEY=your_very_secure_secret_key_for_testing_change_this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Configuration
API_PREFIX=/api/v1

# Frontend Configuration (UPDATE WITH YOUR SERVER IP/DOMAIN)
NEXT_PUBLIC_API_URL=http://your-server-ip:8000
NEXT_PUBLIC_APP_NAME=Supplero Testing
NEXT_PUBLIC_APP_VERSION=1.0.0

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# File Storage Configuration
STORAGE_TYPE=local
STORAGE_PATH=./uploads
MAX_FILE_SIZE=10485760  # 10MB

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@supplero.com

# External API Keys (Optional - for enhanced features)
DUN_BRADSTREET_API_KEY=
REFINITIV_API_KEY=
NEWS_API_KEY=73b1570193ea4621911c859decfda84b

# Monitoring (Optional)
SENTRY_DSN=
DATADOG_API_KEY=
PROMETHEUS_ENABLED=false

